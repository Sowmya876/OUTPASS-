PORT=5000
# Public professor demonstration: use a SEPARATE deployment/database.
# DEMO_MODE=false
# APP_ENV=development
# DEMO_MONGODB_URI=mongodb+srv://<demo-only-user>:<password>@<cluster>/outpass_professor_demo
# TRUST_PROXY_HOPS=0
# Atlas remains the default. Use npm run db:use-local for explicit demo mode.
# DATABASE_MODE=atlas
# LOCAL_MONGODB_URI is generated privately by npm run db:local.
MONGODB_URI=mongodb://127.0.0.1:27017/outpass
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173

# Optional: use a working resolver for Node SRV lookups; leave blank normally.
MONGODB_DNS_SERVERS=

# College onboarding: proposed domain; verify with your institution.
ALLOWED_STUDENT_EMAIL_DOMAIN=sst.scaler.com
ADMIN_EMAIL=admin@outpass.demo
# Test previews only by default. No real email without explicit recipient authorization.
EMAIL_DELIVERY_ENABLED=false
EMAIL_AUTHORIZED_RECIPIENTS=
SUPPORT_EMAIL=support@your-college.example
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
